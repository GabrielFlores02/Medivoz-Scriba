# Aplicacion
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DOMAIN=localhost
FRONTEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:4000/api/v1

# PostgreSQL y Redis
DB_USER=medivoz
DB_PASSWORD=REEMPLAZAR_EN_ENTORNO_SEGURO
DB_NAME=medivoz
DATABASE_URL=postgres://medivoz:REEMPLAZAR_EN_ENTORNO_SEGURO@medivoz-postgres:5432/medivoz
REDIS_URL=redis://medivoz-redis:6379

# Autenticacion: generar valores aleatorios de al menos 32 caracteres
JWT_SECRET=REEMPLAZAR_EN_ENTORNO_SEGURO
REFRESH_TOKEN_SECRET=REEMPLAZAR_EN_ENTORNO_SEGURO

# OpenAI: no guardar la clave real en Git
OPENAI_API_KEY=REEMPLAZAR_EN_ENTORNO_SEGURO

# Audio temporal
AUDIO_TEMP_DIR=/tmp/medivoz-audio
AUDIO_TEMP_UPLOAD_TTL_MINUTES=30
AUDIO_TEMP_ERROR_TTL_MINUTES=120
AUDIO_TEMP_CLEANUP_INTERVAL_MS=300000
AUDIO_TEMP_DELETE_MAX_RETRIES=3

# Procesamiento
EXTRACTION_VERSION_DRIFT_MAX=60
TRANSCRIPTION_MAX_CONCURRENCY=6
AUTOFILL_MAX_CONCURRENCY=8
